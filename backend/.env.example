# 数据库
DATABASE_URL=postgresql+asyncpg://ailearn:ailearn123@localhost:5433/ai_learning

# Redis
REDIS_URL=redis://:redispass@localhost:6379/0
RETRIEVAL_CACHE_TTL_SECONDS=300
DOCUMENT_TASK_MAX_RETRIES=3

# JWT
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ADMIN_USERNAMES=admin

# LLM 多供应商配置（至少配置一个，或使用 mock）
LLM_PROVIDER=mock
# LLM_PROVIDER=deepseek
# LLM_PROVIDER=openai

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# GLM (智谱)
GLM_API_KEY=your-glm-api-key
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4

# Qwen (通义千问)
QWEN_API_KEY=your-qwen-api-key
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Mock 模式配置
LLM_MOCK_DELAY=0.5

# 文件上传
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800
DOCUMENT_EMBED_BATCH_SIZE=32
MAX_CHUNK_SIZE=500
BGE_MAX_CONCURRENCY=1
BGE_QUEUE_TIMEOUT_SECONDS=3.0
BGE_INFERENCE_SERVICE_URL=
BGE_INFERENCE_TIMEOUT_SECONDS=30.0
ANALYTICS_LOOKBACK_DAYS=90
HEALTH_CHECK_TIMEOUT_SECONDS=15.0

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志级别
LOG_LEVEL=INFO

# SMTP 邮件服务配置（可选，用于邮件通知等功能）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@qq.com
# SMTP_PASSWORD=your-smtp-authorization-code
# SMTP_FROM_EMAIL=your-email@qq.com
# SMTP_FROM_NAME=知识星球
# SMTP_USE_TLS=True
